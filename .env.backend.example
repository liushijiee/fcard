APP_ENV=sandbox
HTTP_ADDR=127.0.0.1:8081
SESSION_TTL=8h
DATABASE_SSLMODE=disable

AIRWALLEX_ISSUING_ENABLED=false
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_API_VERSION=2026-08-21
AIRWALLEX_CARD_PROGRAM_PURPOSE=COMMERCIAL
# - COMMERCIAL：用于企业商业支出，例如公司采购、广告、差旅、软件订阅等。(airwallex.com)
# - CONSUMER：用于个人客户消费，关联以个人身份接入的客户；消费者卡必须关联 Individual 持卡人并为个性化卡片。(airwallex.com)
AIRWALLEX_CARD_LIMIT_CENTS=1000

# Local database credentials are loaded from .env.postgres.
# DATABASE_URL can override those credentials in a deployed environment.
# ADMIN_PASSWORD is only used by the admin initialization command.
